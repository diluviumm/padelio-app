http://padelio.naygars.site {
	root * /srv/padelio/public
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	@encoded_sep expression {http.request.uri}.contains("%2F") || {http.request.uri}.contains("%2f") || {http.request.uri}.contains("%5C") || {http.request.uri}.contains("%5c")
	respond @encoded_sep 404
	php_fastcgi 127.0.0.1:9001
	file_server
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
